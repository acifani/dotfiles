[user]
	name = Alessandro Cifani
	email = {{ .email }}
{{- if .signCommits }}
	signingkey = {{ .sshSigningKey }}

[gpg]
	format = ssh
{{- end }}

[column]
	ui = auto

[core]
	pager = delta
	excludesfile = ~/.gitignore_global

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[log]
	abbrevCommit = true
	decorate = true

[commit]
	verbose = true
	gpgsign = {{ .signCommits }}
{{- if and (eq .profile "work") .workEmail }}

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work
{{- end }}

[fetch]
	prune = true
	pruneTags = true
	all = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[rerere]
	enabled = true
	autoupdate = true

[alias]
	co = checkout
	cob = checkout -b
	ls = log --oneline --decorate -10
	ld = log --oneline --decorate --date=relative
	s = status -s
	st = status -sb
	d = diff
	dc = diff --cached
	dw = diff --word-diff
	c = commit
	cam = commit -am
	cm = commit -m
	a = add
	ap = add -p
	p = push
	pob = push origin HEAD
	pf = push --force-with-lease
	b = branch
	undo = reset HEAD~1 --mixed
	amend = commit --amend --no-edit
	wip = "!git add . && git commit -am ""WIP"""
	fix = commit --fixup
	rom = rebase origin/main
	recent = branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\"

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	line-numbers = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- if .dev }}

# difftastic, installed with the dev tools
[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[alias]
	dft = difftool
{{- end }}
{{- if eq .profile "work" }}

[ghq]
	root = ~/work
{{- end }}
