[user]
	name = Alessandro Cifani
	email = {{ .email }}

[column]
	ui = auto

[core]
	pager = delta
	excludesfile = ~/.gitignore_global
	editor = vim

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[log]
	abbrevCommit = true
	decorate = true

[commit]
	verbose = true
	gpgsign = {{ .signCommits }}

[fetch]
	prune = true
	pruneTags = true
	all = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	tool = difftastic

[pager]
	difftool = true

[difftool]
  prompt = false

[rerere]
	enabled = true
	autoupdate = true

[alias]
	co = checkout
	cob = checkout -b
	ls = log --oneline --decorate -10
	ld = log --oneline --decorate --date=relative
	s = status -s
	st = status -sb
	d = diff
	dc = diff --cached
	dw = diff --word-diff
	c = commit
	cam = commit -am
	cm = commit -m
	a = add
	ap = add -p
	p = push
	pob = push origin HEAD
	pf = push --force-with-lease
	b = branch
	sync = fetch --prune
	uncommit = reset HEAD^
	undo = reset HEAD~1 --mixed
	amend = commit --amend --no-edit
	bclean = "!git checkout main && git sync && git pull && git branch -d $(git branch --merged | grep -v main)"
	cleanbranches = "!git checkout -q main && git for-each-ref refs/heads/ '--format=%(refname:short)' | while read branch; do mergeBase=$(git merge-base main $branch) && case $(git cherry main $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) in -*) git branch -D $branch;; esac; done"
	wip = "!git add . && git commit -am ""WIP"""
	unwip = reset HEAD^
	fix = commit --fixup
	rom = rebase origin/main
	recent = branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\"
	dft = difftool

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	line-numbers = true

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
