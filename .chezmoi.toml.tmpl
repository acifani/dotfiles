{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "work" "personal") -}}
{{- $workEmail := "" -}}
{{- if eq $profile "work" -}}
{{-   $workEmail = promptStringOnce . "workEmail" "Git email for ~/work (empty for none)" -}}
{{- end -}}
{{- $dev := promptBoolOnce . "dev" "Install dev tools" -}}
{{- $docker := promptBoolOnce . "docker" "Install docker helpers" -}}
{{- $appdir := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $appdir = promptStringOnce . "appdir" "Cask install directory" "/Applications" -}}
{{- end -}}
{{- $claude := promptBoolOnce . "claude" "Configure Claude Code plugins and skills" false -}}
{{- $codex := promptBoolOnce . "codex" "Configure Codex plugins and skills" false -}}
{{- $opencode := promptBoolOnce . "opencode" "Configure OpenCode plugins and skills" false -}}
{{- $signCommits := promptBoolOnce . "signCommits" "Sign git commits with SSH" -}}
{{- $sshSigningKey := "" -}}
{{- if $signCommits -}}
{{-   $sshSigningKey = promptStringOnce . "sshSigningKey" "Public SSH key to sign with" "~/.ssh/id_ed25519.pub" -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o022

[data]
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}
{{- if eq $profile "work" }}
    workEmail = {{ $workEmail | quote }}
{{- end }}
    dev = {{ $dev }}
    docker = {{ $docker }}
{{- if eq .chezmoi.os "darwin" }}
    appdir = {{ $appdir | quote }}
{{- end }}
    claude = {{ $claude }}
    codex = {{ $codex }}
    opencode = {{ $opencode }}
    signCommits = {{ $signCommits }}
    sshSigningKey = {{ $sshSigningKey | quote }}

[diff]
    pager = "delta"
