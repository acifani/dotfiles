{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Git email for ~/work (empty for none)" -}}
{{- $dev := promptBoolOnce . "dev" "Install dev tools" -}}
{{- $docker := promptBoolOnce . "docker" "Install docker helpers" -}}
{{- $signCommits := promptBoolOnce . "signCommits" "Sign git commits with SSH" -}}
{{- $sshSigningKey := "" -}}
{{- if $signCommits -}}
{{-   $sshSigningKey = promptStringOnce . "sshSigningKey" "Public SSH key to sign with" "~/.ssh/id_ed25519.pub" -}}
{{- end -}}

umask = 0o022

[data]
    email = {{ $email | quote }}
    workEmail = {{ $workEmail | quote }}
    dev = {{ $dev }}
    docker = {{ $docker }}
    signCommits = {{ $signCommits }}
    sshSigningKey = {{ $sshSigningKey | quote }}

[diff]
    pager = "delta"
