#!/bin/bash
# Generates ~/.fzf.zsh (key bindings + completion) once per machine.
set -uo pipefail
{{ if eq .chezmoi.os "darwin" -}}
installer="$(brew --prefix)/opt/fzf/install"
{{- else -}}
installer="$HOME/.fzf/install"
{{- end }}
[ -x "$installer" ] && "$installer" --key-bindings --completion --no-update-rc
exit 0
