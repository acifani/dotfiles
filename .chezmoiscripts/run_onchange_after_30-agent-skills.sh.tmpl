{{- $agents := list -}}
{{- if .claude }}{{ $agents = append $agents "claude-code" }}{{ end -}}
{{- if .codex }}{{ $agents = append $agents "codex" }}{{ end -}}
{{- if .opencode }}{{ $agents = append $agents "opencode" }}{{ end -}}
{{- if $agents -}}
#!/bin/bash
# Installs skills that no plugin ships, at their latest version, into
# ~/.agents/skills (read by Codex, OpenCode, Cursor) and linked into
# ~/.claude/skills. Re-runs whenever this file or the harness flags change.
# Additive: removing an entry here does not uninstall it (`npx skills remove -g`).
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v npx >/dev/null; then
    echo "npx not found (node comes with the dev flag); skipping skills. Install it, then re-run:" >&2
    echo "  chezmoi execute-template < \"\$(chezmoi source-path)/.chezmoiscripts/run_onchange_after_30-agent-skills.sh.tmpl\" | bash" >&2
    exit 0
fi

agents=({{ $agents | join " " }})
agent_args=()
for a in "${agents[@]}"; do agent_args+=(-a "$a"); done

# Run outside any project so the skills CLI never picks project scope.
cd "$HOME"
npx -y skills add ast-grep/agent-skill -s ast-grep -s ast-grep-outline -g "${agent_args[@]}" -y
{{- end }}
