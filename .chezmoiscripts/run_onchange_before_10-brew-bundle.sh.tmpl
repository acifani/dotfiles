{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Re-runs whenever the rendered Brewfile changes. Hash: {{ includeTemplate "Brewfile" . | sha256sum }}
set -euo pipefail
appdir={{ regexReplaceAll "^~" .appdir .chezmoi.homeDir | quote }}
mkdir -p "$appdir"
export HOMEBREW_CASK_OPTS="${HOMEBREW_CASK_OPTS:-} --appdir=$appdir"
brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT
cat > "$brewfile" <<'BREWFILE'
{{ includeTemplate "Brewfile" . }}
BREWFILE
brew bundle --file="$brewfile"
{{ end -}}
