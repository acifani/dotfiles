[tools]
# baseline: every machine
bat = "latest"
delta = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
git-lfs = "latest"
jq = "latest"
neovim = "latest"
ripgrep = "latest"
starship = "latest"
zoxide = "latest"
{{- if .dev }}

# dev
ast-grep = "latest"
bun = "latest"
"github:Wilfred/difftastic" = "latest"  # aqua registry asset name is stale
gh = "latest"
git-filter-repo = "latest"
go = "latest"
pnpm = "latest"
python = "latest"
uv = "latest"
{{- end }}
{{- if or .dev .claude .codex .opencode }}

# node
node = "lts"
{{- end }}
{{- if eq .profile "work" }}

# work
ghq = "latest"
{{- end }}
{{- if .docker }}

# docker
dive = "latest"
{{- end }}

[settings]
auto_update = true
