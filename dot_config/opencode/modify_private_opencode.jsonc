{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merges the plugins, skill paths and settings below into
  ~/.config/opencode/opencode.jsonc and leaves every other key alone, since
  OpenCode writes this file too. OpenCode installs missing plugins on start.
  The file must stay plain JSON: fromJson can't parse comments.
  Additive: removing an entry here does not uninstall it.
*/ -}}

{{- $plugins := list
      "github:michael-denyer/pstack-claude#main"
-}}
{{- /* Matt's shipped skills, cloned by .chezmoiexternal.toml.tmpl. */ -}}
{{- $skills := list
      "~/.local/share/opencode-skills/mattpocock/skills/engineering"
      "~/.local/share/opencode-skills/mattpocock/skills/productivity"
-}}
{{- /* Top-level settings to enforce, e.g. "model" "anthropic/claude-opus-5-5". */ -}}
{{- $settings := dict -}}

{{- $c := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $c = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $have := concat (get $c "plugins" | default list) (get $c "plugin" | default list) -}}
{{- $out := get $c "plugins" | default list -}}
{{- range $plugins -}}
{{-   if not (has . $have) -}}
{{-     $out = append $out . -}}
{{-   end -}}
{{- end -}}
{{- $c = set $c "plugins" $out -}}
{{- $out = get $c "skills" | default list -}}
{{- range $skills -}}
{{-   if not (has . $out) -}}
{{-     $out = append $out . -}}
{{-   end -}}
{{- end -}}
{{- $c = set $c "skills" $out -}}
{{- range $key, $value := $settings -}}
{{-   $c = set $c $key $value -}}
{{- end -}}
{{- /* Already up to date: keep the file as the harness wrote it. */ -}}
{{- if and (trim .chezmoi.stdin) (eq (toJson (fromJson .chezmoi.stdin)) (toJson $c)) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{    toPrettyJson "  " $c -}}
{{- end -}}
