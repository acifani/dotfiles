#!/usr/bin/env bash
# docker ps -a, tidied up: running containers first, sorted by name, container-side ports only.
# Extra arguments go to `docker ps` (e.g. `dps -f name=web`).
set -euo pipefail

docker ps -a --format '{{.State}}\t{{.Names}}\t{{.Image}}\t{{.ID}}\t{{.Ports}}' "$@" |
    awk -F'\t' -v OFS='\t' '{
        # "0.0.0.0:8080->80/tcp, [::]:8080->80/tcp, 443/tcp" -> "80 443"
        ports = ""; delete seen
        n = split($5, p, /, */)
        for (i = 1; i <= n; i++) {
            if (!match(p[i], /[0-9]+\/(tcp|udp)$/)) continue
            port = substr(p[i], RSTART, RLENGTH); sub(/\/.*/, "", port)
            if (!(port in seen)) { seen[port]; ports = ports (ports == "" ? "" : " ") port }
        }
        print ($1 == "running" ? 0 : 1), $2, $3, $4, ports
    }' |
    sort -t $'\t' -k1,1n -k2,2 |
    awk -F'\t' '
        { rows[NR] = $0; for (i = 2; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i) }
        END {
            split("NAME IMAGE ID PORTS", h, " ")
            for (i = 2; i <= 5; i++) if (length(h[i-1]) > w[i]) w[i] = length(h[i-1])
            printf "  \033[1m%-" w[2] "s  %-" w[3] "s  %-" w[4] "s  %s\033[0m\n", h[1], h[2], h[3], h[4]
            for (r = 1; r <= NR; r++) {
                split(rows[r], f, "\t")
                state = f[1] == 0 ? "\033[32m●" : "\033[31m●"
                printf "%s \033[1m%-" w[2] "s\033[0m  \033[34m%-" w[3] "s\033[0m  \033[33m%-" w[4] "s\033[0m  \033[90m%s\033[0m\n", state, f[2], f[3], f[4], f[5]
            }
        }'
