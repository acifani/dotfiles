#!/usr/bin/env bash
# docker images, tidied up: sorted by name and tag, aligned and colored.
# Extra arguments go to `docker images` (e.g. `dim 'caprover/*'`).
set -euo pipefail

docker images --format '{{.Repository}}\t{{.Tag}}\t{{.ID}}\t{{.Size}}' "$@" |
    sort -t $'\t' -k1,1 -k2,2 |
    awk -F'\t' '
        { rows[NR] = $0; for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i) }
        END {
            split("NAME TAG ID SIZE", h, " ")
            for (i = 1; i <= 4; i++) if (length(h[i]) > w[i]) w[i] = length(h[i])
            printf "\033[1m%-" w[1] "s  %-" w[2] "s  %-" w[3] "s  %s\033[0m\n", h[1], h[2], h[3], h[4]
            for (r = 1; r <= NR; r++) {
                split(rows[r], f, "\t")
                printf "\033[34m%-" w[1] "s\033[0m  \033[90m%-" w[2] "s\033[0m  \033[33m%-" w[3] "s\033[0m  \033[36m%s\033[0m\n", f[1], f[2], f[3], f[4]
            }
        }'
