[".zgenom"]
    type = "git-repo"
    url = "https://github.com/jandamm/zgenom.git"
    refreshPeriod = "168h"

[".vim/autoload/plug.vim"]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    refreshPeriod = "168h"
{{- if .opencode }}

# OpenCode has no plugin marketplace, so it gets Matt's skills from a clone.
# It lives outside OpenCode's scanned skill dirs: the repo also holds
# in-progress/misc skills, and opencode.jsonc points only at the shipped ones.
[".local/share/opencode-skills/mattpocock"]
    type = "git-repo"
    url = "https://github.com/mattpocock/skills.git"
    refreshPeriod = "168h"
{{- end }}
